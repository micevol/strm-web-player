# =========================================================
# STRM Web Player - docker compose 配置示例
# 复制为 .env 后按需修改，然后执行:
#   docker compose up -d --build
# =========================================================

# 宿主机监听端口（默认 14000）
HOST_PORT=14000

# 你的 strm 文件所在目录（宿主机绝对路径，注意容器内为 /data/strm）
# 例：STRM_HOST_PATH=/media/我的网盘影视/strm
STRM_HOST_PATH=./strm

# JWT 会话签名密钥 - 必改！请换成长随机字符串
#   Linux 生成：openssl rand -base64 48
JWT_SECRET=please-change-me-to-a-long-random-secret

# 首次启动自动创建的管理员账号（格式 用户名:密码）
SEED_ADMIN=admin:admin123

# 是否允许网页自助注册（true/false）
ALLOW_REGISTER=true

# strm 内允许播放的远程域名白名单（逗号分隔）；* 表示不限制
ALLOWED_HOSTS=*